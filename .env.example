# Copier ce fichier en `.env.local` et renseigner les valeurs.
# `.env.local` est ignoré par git.

# URL publique du site. En développement derrière un tunnel Cloudflare,
# mettre l'URL du tunnel ; en production, https://pandarp.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Code de connexion cfx.re du serveur, visible sur le portail Cfx.re.
# Alimente le bouton « Rejoindre » et le compteur de joueurs en direct.
NEXT_PUBLIC_CFX_ID=

# ID du serveur Discord. Le widget doit être activé dans
# Paramètres du serveur > Widget, sans quoi l'API renvoie une erreur.
NEXT_PUBLIC_DISCORD_GUILD_ID=

# Lien d'invitation permanent du Discord.
NEXT_PUBLIC_DISCORD_INVITE=
